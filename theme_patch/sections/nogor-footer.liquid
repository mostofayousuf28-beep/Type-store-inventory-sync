<footer class="ne-footer">
  <div class="ne-footer__inner">
    <div class="ne-footer__col ne-footer__brand">
      <a href="{{ routes.root_url }}" class="ne-footer__logo">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 200 | image_tag: alt: 'Nogor Essentials', loading: 'lazy', width: 56, height: 56 }}
        {%- endif -%}
        <span>Nogor Essentials</span>
      </a>
      <p>Everyday essentials for city life, delivered to your door anywhere in Bangladesh.</p>
    </div>

    <nav class="ne-footer__col" aria-label="Help">
      <h3>Help</h3>
      <ul>
        {%- for policy in shop.policies -%}
          {%- if policy.url contains 'privacy' -%}
            <li><a href="{{ policy.url }}">Privacy Policy</a></li>
          {%- endif -%}
        {%- endfor -%}
        {%- for policy in shop.policies -%}
          {%- if policy.url contains 'refund' -%}
            <li><a href="{{ policy.url }}">Refund Policy</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    <div class="ne-footer__col">
      <h3>Contact</h3>
      <ul class="ne-footer__contact">
        <li><a href="tel:+8801331616019">{% render 'nogor-icons', icon: 'phone' %}<span>01331-616019 (WhatsApp)</span></a></li>
        <li><a href="https://www.facebook.com/profile.php?id=61565789341267" target="_blank" rel="noopener">{% render 'nogor-icons', icon: 'facebook' %}<span>Facebook Page</span></a></li>
        <li><span class="ne-footer__plain">{% render 'nogor-icons', icon: 'pin' %}<span>Dhaka, Bangladesh</span></span></li>
      </ul>
    </div>
  </div>

  <div class="ne-footer__bar">
    <div class="ne-footer__bar-inner">
      <span>&copy; {{ 'now' | date: '%Y' }} Nogor Essentials. All rights reserved.</span>
      <span class="ne-footer__pay">{% render 'nogor-icons', icon: 'cash' %} Cash on Delivery</span>
    </div>
  </div>
</footer>

<style>
  .ne-footer { background: var(--ne-slate, #4d5556); color: #e9eeed; }
  .ne-footer a { color: inherit; text-decoration: none; }
  .ne-footer a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .ne-footer__inner {
    max-width: var(--page-width, 1400px); margin: 0 auto; padding: 52px var(--page-margin, 20px) 44px;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; align-items: start;
  }
  .ne-footer__logo { display: inline-flex; align-items: center; gap: 12px; font-weight: 700; font-size: 1.15rem; color: #fff; }
  .ne-footer__logo:hover { text-decoration: none; }
  .ne-footer__logo img { width: 56px; height: 56px; border-radius: 50%; background: #fff; object-fit: contain; }
  .ne-footer__brand p { margin: 16px 0 0; font-size: .95rem; line-height: 1.7; color: #d3dbd9; max-width: 32ch; }
  .ne-footer h3 { color: #fff; font-size: 1rem; font-weight: 700; margin: 0 0 16px; height: 56px; display: flex; align-items: center; }
  .ne-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; font-size: .95rem; }
  .ne-footer__contact a, .ne-footer__plain { display: inline-flex; align-items: center; gap: 10px; }
  .ne-footer__contact svg { width: 18px; height: 18px; flex: none; opacity: .9; }
  .ne-footer__bar { border-top: 1px solid rgba(255,255,255,.14); }
  .ne-footer__bar-inner {
    max-width: var(--page-width, 1400px); margin: 0 auto; padding: 16px var(--page-margin, 20px);
    display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: .85rem; color: #c5cecc;
  }
  .ne-footer__pay { display: inline-flex; align-items: center; gap: 8px; }
  .ne-footer__pay svg { width: 20px; height: 20px; }
  @media (max-width: 749px) {
    .ne-footer__inner { grid-template-columns: 1fr; gap: 28px; padding-top: 40px; padding-bottom: 32px; text-align: center; }
    .ne-footer__logo, .ne-footer__contact a, .ne-footer__plain { justify-content: center; }
    .ne-footer__brand p { margin-left: auto; margin-right: auto; }
    .ne-footer h3 { height: auto; justify-content: center; margin-bottom: 14px; }
    .ne-footer ul { justify-items: center; }
    .ne-footer__bar-inner { justify-content: center; text-align: center; padding-bottom: 84px; }
  }
</style>

{% schema %}
{
  "name": "Nogor footer",
  "settings": []
}
{% endschema %}
