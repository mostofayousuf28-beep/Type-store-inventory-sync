{%- comment -%} Nogor Essentials: global design tweaks (Bangla font, badges, product page, floating contact) {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    /* Lato has no Bangla glyphs: let Bangla text fall back to Hind Siliguri instead of a random system font */
    --font-body--family: {{ settings.type_body_font.family }}, 'Hind Siliguri', {{ settings.type_body_font.fallback_families }};
    --font-subheading--family: {{ settings.type_subheading_font.family }}, 'Hind Siliguri', {{ settings.type_subheading_font.fallback_families }};
    --font-heading--family: {{ settings.type_heading_font.family }}, 'Hind Siliguri', {{ settings.type_heading_font.fallback_families }};
    --ne-green: #057668;
    --ne-green-dark: #045a4f;
    --ne-slate: #4d5556;
    --ne-wa: #25d366;
    --ne-wa-dark: #128c4b;
    --ne-soft: #eaf4f2;
  }

  /* Sale badge: brand colour */
  .product-badges__badge {
    background: #c0392b !important;
    color: #fff !important;
    font-weight: 700;
    letter-spacing: .02em;
  }

  /* Product page: calmer title size on phones */
  @media (max-width: 749px) {
    .template-product main .text-block h1,
    main .text-block.h3 h1 {
      font-size: 1.45rem !important;
      line-height: 1.3 !important;
    }
  }

  /* Product description: readable spacing */
  main .rte p, main .text-block p { line-height: 1.7; }

  /* ---------- Order / trust block on product page ---------- */
  .ne-btn {
    display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%;
    min-height: 50px; padding: 12px 16px; border-radius: 14px; margin: 2px 0;
    font-weight: 600; font-size: 1rem; text-decoration: none; line-height: 1.2;
    transition: background-color .15s ease;
  }
  .ne-btn svg { width: 22px; height: 22px; flex: none; }
  .ne-btn--wa { background: var(--ne-green); color: #fff; }
  .ne-btn--wa:hover { background: var(--ne-green-dark); color: #fff; }

  .ne-trust {
    list-style: none; margin: 6px 0 0; padding: 14px 16px; border-radius: 14px;
    background: var(--ne-soft); display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px;
  }
  .ne-trust li { display: flex; align-items: flex-start; gap: 10px; font-size: .9rem; line-height: 1.35; color: #1d2b28; }
  .ne-trust li svg { width: 22px; height: 22px; flex: none; color: var(--ne-green); }
  .ne-trust b { display: block; font-weight: 600; }
  .ne-trust small { color: #4f5f5b; font-size: .8rem; }
  @media (max-width: 420px) { .ne-trust { grid-template-columns: 1fr; } }

  /* ---------- Floating WhatsApp / call ---------- */
  .ne-float { position: fixed; right: 18px; bottom: 20px; z-index: 60; display: flex; flex-direction: column; gap: 10px; align-items: flex-end; }
  .ne-float a {
    width: 54px; height: 54px; border-radius: 50%; display: grid; place-items: center;
    box-shadow: 0 6px 18px rgba(0,0,0,.18); color: #fff; text-decoration: none;
    transition: transform .15s ease;
  }
  .ne-float a:hover { transform: scale(1.06); }
  .ne-float svg { width: 28px; height: 28px; }
  .ne-float .ne-float__wa { background: var(--ne-green); }
  .ne-float .ne-float__call { background: var(--ne-green); width: 46px; height: 46px; }
  .ne-float .ne-float__call svg { width: 22px; height: 22px; }
  @media (max-width: 749px) {
    .ne-float { right: 14px; bottom: 16px; }
    .ne-float--product { display: none; }
    .ne-float a { width: 50px; height: 50px; }
  }
  /* ---------- Compact category dropdown (desktop) ---------- */
  @media (min-width: 750px) {
    .overflow-menu::after { display: none !important; }
    .menu-list__list-item { position: relative; }
    .menu-list__submenu {
      left: -16px !important; right: auto !important; width: 440px !important; top: calc(100% + 6px) !important;
      clip-path: none !important; height: auto !important; min-height: 0 !important;
      border-radius: 16px; box-shadow: 0 14px 36px rgba(0,0,0,.16); background: #fff !important; overflow: hidden;
    }
    .menu-list__submenu-inner { padding: 10px !important; min-height: 0 !important; }
    .menu-list__submenu .mega-menu { padding: 0 !important; margin: 0 !important; width: auto !important; min-height: 0 !important; }
    .menu-list__submenu .mega-menu__grid { display: block !important; padding: 0 !important; min-height: 0 !important; }
    .menu-list__submenu .mega-menu__list { display: block !important; padding: 0 !important; }
    .menu-list__submenu .mega-menu__column { display: grid !important; grid-template-columns: 1fr 1fr; gap: 2px 6px; padding: 0 !important; }
    .menu-list__submenu .mega-menu__link {
      display: block; padding: 9px 14px !important; border-radius: 10px;
      font-size: .95rem !important; line-height: 1.3 !important; color: #1d2b28 !important; white-space: nowrap;
    }
    .menu-list__submenu .mega-menu__link:hover { background: var(--ne-soft); color: var(--ne-green) !important; }
  }
  /* ---------- Product cards: square images, 3-line titles, equal heights ---------- */
  .product-card__content > a.contents .text-block p {
    display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical;
    overflow: hidden; line-height: 1.45; min-height: calc(1.45em * 3); margin: 0;
  }
  .product-card:has(.nogor-save-badge) .product-badges { display: none !important; }
  .resource-list__item, .resource-list__item > product-card-link { height: 100%; }
  .resource-list__item product-card { height: 100%; }
  /* ---------- Product page gallery: smaller, square, thumbnails below ---------- */
  @media (min-width: 750px) {
    .product-information__media { max-width: 560px; width: 100%; justify-self: center; }
  }
  .product-information__media .slideshow-controls__thumbnails img,
  .product-information__media [class*=thumbnail] img { object-fit: cover; }

  /* ---------- Design option as picture swatches ---------- */
  .variant-option__button-label:has(.ne-design-swatch) {
    padding: 0 !important; width: 68px; height: 68px; min-width: 0 !important; flex: 0 0 auto;
    border-radius: 12px !important; overflow: hidden; border: 1.5px solid #e2e2e2 !important; background: #fff;
  }
  .variant-option__button-label:has(.ne-design-swatch) .variant-option__button-label__pill { display: none; }
  .variant-option__button-label:has(.ne-design-swatch):has(input:checked) {
    border: 2px solid var(--ne-green) !important; box-shadow: 0 0 0 2px #fff inset;
  }
  .ne-design-swatch, .ne-design-swatch img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .variant-option--buttons:has(.ne-design-swatch) { display: flex; flex-wrap: wrap; gap: 8px; }
  @media (max-width: 749px) {
    .variant-option__button-label:has(.ne-design-swatch) { width: 58px; height: 58px; }
  }
</style>
